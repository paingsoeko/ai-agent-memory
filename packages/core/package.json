{
  "name": "@ai-memory/core",
  "version": "0.1.0",
  "description": "Local-first, agent-agnostic memory engine for AI coding agents (SQLite + FTS5 + optional embeddings)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/storage/sqlite/index.d.ts",
      "import": "./dist/storage/sqlite/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/core"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-memory/ai-memory.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "local-first",
    "sqlite",
    "mcp",
    "claude",
    "codex",
    "gemini"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
