{
  "name": "@local-ai-agent-memory/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the local @ai-memory store to any MCP-capable agent",
  "license": "MIT",
  "author": "paingsoeko",
  "homepage": "https://github.com/paingsoeko/ai-agent-memory/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/paingsoeko/ai-agent-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paingsoeko/ai-agent-memory.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "local-first",
    "sqlite",
    "mcp",
    "claude",
    "codex",
    "gemini"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ai-memory-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@local-ai-agent-memory/core": "workspace:^",
    "@local-ai-agent-memory/embeddings": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  }
}
