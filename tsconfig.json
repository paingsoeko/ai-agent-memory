{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@ai-agent-memory/core": ["packages/core/src/index.ts"],
      "@ai-agent-memory/embeddings": ["packages/embeddings/src/index.ts"],
      "@ai-agent-memory/cli": ["packages/cli/src/index.ts"],
      "@ai-agent-memory/mcp": ["packages/mcp/src/index.ts"],
      "@ai-agent-memory/adapter-claude": ["packages/adapters/claude/src/index.ts"],
      "@ai-agent-memory/adapter-codex": ["packages/adapters/codex/src/index.ts"],
      "@ai-agent-memory/adapter-gemini": ["packages/adapters/gemini/src/index.ts"],
      "@ai-agent-memory/adapter-opencode": ["packages/adapters/opencode/src/index.ts"],
      "@ai-agent-memory/adapter-openrouter": ["packages/adapters/openrouter/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/adapters/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/adapters/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
